#!/usr/bin/env bash
# ai-workspace用 codex ラッパー
# projects/ 配下のディレクトリを --add-dir に自動追加して起動する

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PROJECTS_DIR="${WORKSPACE_ROOT}/projects"
SYNC_SCRIPT="${WORKSPACE_ROOT}/scripts/sync-codex-project-config.sh"

add_dirs=()
if [[ -d "${PROJECTS_DIR}" ]]; then
  while IFS= read -r -d '' entry; do
    [[ -d "${entry}" ]] || continue
    add_dirs+=("${entry}")
  done < <(find "${PROJECTS_DIR}" -mindepth 1 -maxdepth 1 -print0)
fi

"${SYNC_SCRIPT}"

cmd=(codex --sandbox workspace-write)
for dir in "${add_dirs[@]}"; do
  cmd+=(--add-dir "${dir}")
done
cmd+=("$@")

exec "${cmd[@]}"
